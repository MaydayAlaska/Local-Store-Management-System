<UserControl
    x:Class="LocalStoreManagement.Desktop.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False">

    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,20" Spacing="16" MaxWidth="980" HorizontalAlignment="Stretch">
            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="SectionTitle" Text="Negozio" />
                        <TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="Identità mostrata nel gestionale e nelle esportazioni." />
                    </StackPanel>
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="16">
                        <StackPanel Spacing="5"><TextBlock Classes="FieldLabel" Text="NOME NEGOZIO" /><CheckBox x:Name="ShowShopNameInMenuInput" Content="Mostra nel menu laterale" /></StackPanel>
                        <TextBox x:Name="ShopNameInput" Grid.Column="1" VerticalAlignment="Top" PlaceholderText="Negozio" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4"><TextBlock Classes="SectionTitle" Text="Branding" /><TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="Personalizza icona e logo senza modificare i pacchetti installati." /></StackPanel>
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="16">
                        <StackPanel Spacing="4"><TextBlock Classes="FieldLabel" Text="ICONA PROGRAMMA" /><TextBlock Classes="Muted" FontSize="11" TextWrapping="Wrap" Text="Finestra, taskbar e collegamenti Windows." /></StackPanel>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"><Button Click="ChooseIconButton_OnClick" Content="Scegli immagine…" /><TextBlock x:Name="IconFileText" Grid.Column="1" Classes="Muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="Nessuna icona personalizzata." /></Grid>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" />
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="16">
                        <StackPanel Spacing="5"><TextBlock Classes="FieldLabel" Text="LOGO NEGOZIO" /><CheckBox x:Name="ShowLogoInMenuInput" Content="Mostra nel menu laterale" /></StackPanel>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"><Button Click="ChooseLogoButton_OnClick" Content="Scegli immagine…" /><TextBlock x:Name="LogoFileText" Grid.Column="1" Classes="Muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="Nessun logo selezionato." /></Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4"><TextBlock Classes="SectionTitle" Text="Dati e aggiornamenti" /><TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="Informazioni locali dell'installazione e canale software." /></StackPanel>
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="16"><TextBlock Classes="FieldLabel" Text="CARTELLA DATI" /><TextBlock x:Name="DataDirectoryText" Grid.Column="1" Classes="Muted" TextWrapping="Wrap" /></Grid>
                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" />
                    <Grid ColumnDefinitions="160,*" ColumnSpacing="16">
                        <TextBlock Classes="FieldLabel" Text="VERSIONE" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <WrapPanel><TextBlock x:Name="VersionText" Margin="0,0,12,8" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" /><Button x:Name="CheckUpdatesButton" Margin="0,0,0,8" Click="CheckUpdatesButton_OnClick" Content="Controlla aggiornamenti" /></WrapPanel>
                            <TextBlock x:Name="UpdateStatusText" MaxWidth="720" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" IsVisible="False" Foreground="#C12820" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Button Classes="Primary" Click="SaveButton_OnClick" Content="Salva impostazioni" /><TextBlock x:Name="StatusText" Grid.Column="1" Classes="Muted" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid>
            <TextBlock Classes="Muted" FontSize="11" TextWrapping="Wrap" Text="Immagini supportate: PNG, JPG, BMP; per l'icona è supportato anche ICO." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
