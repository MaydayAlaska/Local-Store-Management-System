<Window
    x:Class="LocalStoreManagement.Desktop.CategoryDeleteWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Elimina categoria"
    Width="560"
    Height="380"
    MinWidth="360"
    MinHeight="300"
    CanResize="True"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="18,16" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1"><StackPanel Spacing="4"><TextBlock FontSize="22" FontWeight="SemiBold" Text="Conferma eliminazione" TextWrapping="Wrap" /><TextBlock Foreground="#66707A" Text="Questa operazione non può essere annullata." TextWrapping="Wrap" /></StackPanel></Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"><StackPanel Margin="18" Spacing="16"><Border Padding="14" CornerRadius="8" Background="#FFF4E5"><TextBlock x:Name="WarningText" Foreground="#8A4B00" TextWrapping="Wrap" /></Border><StackPanel x:Name="ReassignPanel" Spacing="6"><TextBlock FontWeight="SemiBold" Text="Gestione dei prodotti collegati" TextWrapping="Wrap" /><TextBlock Foreground="#66707A" TextWrapping="Wrap" Text="Scegli una categoria di destinazione oppure lascia i prodotti senza categoria." /><ComboBox x:Name="TargetCategoryInput"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></StackPanel></ScrollViewer>
        <Border Grid.Row="2" Padding="18,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Click="CancelButton_OnClick" Content="Annulla" /><Button Click="ConfirmButton_OnClick" Content="Elimina categoria" /></StackPanel></Border>
    </Grid>
</Window>
