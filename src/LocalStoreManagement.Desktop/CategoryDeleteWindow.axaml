<Window
    x:Class="LocalStoreManagement.Desktop.CategoryDeleteWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Elimina categoria"
    Width="560"
    Height="360"
    MinWidth="520"
    MinHeight="320"
    CanResize="False"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="22,18" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Conferma eliminazione" />
                <TextBlock Foreground="#66707A" Text="Questa operazione non può essere annullata." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="22" Spacing="16">
            <Border Padding="14" CornerRadius="8" Background="#FFF4E5">
                <TextBlock x:Name="WarningText" Foreground="#8A4B00" TextWrapping="Wrap" />
            </Border>

            <StackPanel x:Name="ReassignPanel" Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Gestione dei prodotti collegati" />
                <TextBlock Foreground="#66707A" TextWrapping="Wrap" Text="Scegli una categoria di destinazione oppure lascia i prodotti senza categoria." />
                <ComboBox x:Name="TargetCategoryInput">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Padding="22,14" BorderBrush="#D8DDE3" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Button Grid.Column="1" Click="CancelButton_OnClick" Content="Annulla" />
                <Button Grid.Column="2" Click="ConfirmButton_OnClick" Content="Elimina categoria" />
            </Grid>
        </Border>
    </Grid>
</Window>
