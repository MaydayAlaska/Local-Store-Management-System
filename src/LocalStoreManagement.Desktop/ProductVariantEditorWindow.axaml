<Window
    x:Class="LocalStoreManagement.Desktop.ProductVariantEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Variante prodotto"
    Width="620"
    Height="720"
    MinWidth="420"
    MinHeight="520"
    Background="{DynamicResource AppBackgroundBrush}"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="20,18,20,12">
            <StackPanel Spacing="3"><TextBlock x:Name="EditorTitle" FontSize="25" FontWeight="SemiBold" Text="Nuova variante" TextWrapping="Wrap" /><TextBlock x:Name="ProductNameText" Classes="Muted" FontSize="12" TextWrapping="Wrap" /></StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="18,4,18,18" Spacing="14">
                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="SectionTitle" Text="Identificazione variante" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="6"><TextBlock Classes="FieldLabel" Text="CODICE INTERNO / SKU *" /><TextBox x:Name="SkuInput" PlaceholderText="ART000001" /></StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="GenerateSkuButton_OnClick" Content="Genera" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="6"><TextBlock Classes="FieldLabel" Text="VARIANTE / COLORE" /><TextBox x:Name="VariantInput" PlaceholderText="es. Nero, Rosso, Limited" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Classes="FieldLabel" Text="TAGLIA" /><TextBox x:Name="SizeInput" PlaceholderText="es. M, 42, 10 anni" /></StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Classes="FieldLabel" Text="BARCODE / EAN" />
                            <TextBox x:Name="BarcodesInput" Height="100" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Inserisci un barcode per riga. Il primo viene usato come barcode principale." />
                            <TextBlock Classes="Muted" FontSize="11" TextWrapping="Wrap" Text="Ogni barcode deve essere unico in tutto il gestionale. Puoi inserire anche codici alternativi della stessa variante, uno per riga." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="SectionTitle" Text="Prezzi e stato" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="6"><TextBlock Classes="FieldLabel" Text="PREZZO ACQUISTO (€)" /><TextBox x:Name="PurchasePriceInput" PlaceholderText="0,00" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6"><TextBlock Classes="FieldLabel" Text="PREZZO VENDITA (€)" /><TextBox x:Name="SalePriceInput" PlaceholderText="0,00" /></StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto"><CheckBox x:Name="IsActiveInput" IsChecked="True" Content="Variante attiva" /><TextBlock x:Name="StockText" Grid.Column="1" Classes="Muted" VerticalAlignment="Center" TextWrapping="Wrap" /></Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="ErrorPanel" Classes="InsetCard" Padding="12" Background="{DynamicResource AppOrangeSoftBrush}" IsVisible="False"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource AppOrangeTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="18,12,18,16" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8"><TextBlock Classes="Muted" FontSize="11" Text="* campo obbligatorio" /><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Click="CancelButton_OnClick" Content="Annulla" /><Button Classes="Primary" Click="SaveButton_OnClick" Content="Conferma variante" /></StackPanel></Grid>
        </Border>
    </Grid>
</Window>
