<Application
    x:Class="LocalStoreManagement.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Glass backdrop and surfaces -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="AppFallbackBackgroundBrush" Color="#EAF2FA" />
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#90FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#C2FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#84FFFFFF" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#A8FFFFFF" />
                    <SolidColorBrush x:Key="AppControlBorderBrush" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="AppHoverBrush" Color="#180E6FFF" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#172033" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#667085" />

                    <SolidColorBrush x:Key="AppAccentBrush" Color="#3B82F6" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#2A3B82F6" />

                    <SolidColorBrush x:Key="AppGreenBrush" Color="#22C55E" />
                    <SolidColorBrush x:Key="AppGreenSoftBrush" Color="#2922C55E" />
                    <SolidColorBrush x:Key="AppGreenTextBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="AppGreenBorderBrush" Color="#5C22C55E" />

                    <SolidColorBrush x:Key="AppOrangeBrush" Color="#F59E0B" />
                    <SolidColorBrush x:Key="AppOrangeSoftBrush" Color="#2CF59E0B" />
                    <SolidColorBrush x:Key="AppOrangeTextBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="AppOrangeBorderBrush" Color="#62F59E0B" />

                    <SolidColorBrush x:Key="AppRedBrush" Color="#EF4444" />
                    <SolidColorBrush x:Key="AppRedSoftBrush" Color="#2CEF4444" />
                    <SolidColorBrush x:Key="AppRedTextBrush" Color="#B91C1C" />
                    <SolidColorBrush x:Key="AppRedBorderBrush" Color="#62EF4444" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- Dark glass keeps the same transparency hierarchy with a deeper tint. -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#16070B12" />
                    <SolidColorBrush x:Key="AppFallbackBackgroundBrush" Color="#0D1119" />
                    <SolidColorBrush x:Key="AppChromeBrush" Color="#68202A38" />
                    <SolidColorBrush x:Key="AppSidebarBrush" Color="#7A202A38" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#A52A3546" />
                    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#74313D50" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="AppControlBorderBrush" Color="#4AFFFFFF" />
                    <SolidColorBrush x:Key="AppHoverBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#F3F7FF" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#A9B4C7" />

                    <SolidColorBrush x:Key="AppAccentBrush" Color="#66A7FF" />
                    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#84B8FF" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#3466A7FF" />

                    <SolidColorBrush x:Key="AppGreenBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="AppGreenSoftBrush" Color="#304ADE80" />
                    <SolidColorBrush x:Key="AppGreenTextBrush" Color="#86EFAC" />
                    <SolidColorBrush x:Key="AppGreenBorderBrush" Color="#514ADE80" />

                    <SolidColorBrush x:Key="AppOrangeBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="AppOrangeSoftBrush" Color="#30FBBF24" />
                    <SolidColorBrush x:Key="AppOrangeTextBrush" Color="#FCD34D" />
                    <SolidColorBrush x:Key="AppOrangeBorderBrush" Color="#52FBBF24" />

                    <SolidColorBrush x:Key="AppRedBrush" Color="#FB7185" />
                    <SolidColorBrush x:Key="AppRedSoftBrush" Color="#31FB7185" />
                    <SolidColorBrush x:Key="AppRedTextBrush" Color="#FDA4AF" />
                    <SolidColorBrush x:Key="AppRedBorderBrush" Color="#55FB7185" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/AppleLikeTheme.axaml" />
    </Application.Styles>
</Application>
