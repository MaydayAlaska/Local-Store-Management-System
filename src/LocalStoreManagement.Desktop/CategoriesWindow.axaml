<Window
    x:Class="LocalStoreManagement.Desktop.CategoriesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Categorie"
    Width="760"
    Height="620"
    MinWidth="680"
    MinHeight="540"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="24,20" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Categorie" />
                <TextBlock Foreground="#66707A" Text="Crea, rinomina ed elimina le categorie usate dai prodotti." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
            <Border Padding="16" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                        <TextBlock FontWeight="SemiBold" Text="Nuova categoria" />
                        <TextBox x:Name="NewCategoryNameInput" PlaceholderText="Nome categoria" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="CreateButton_OnClick" Content="+ Crea" />
                </Grid>
            </Border>

            <Border Grid.Row="1" BorderBrush="#D8DDE3" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <ListBox x:Name="CategoriesList" SelectionChanged="CategoriesList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,9" ColumnDefinitions="70,*,140">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Id}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#66707A" Text="{Binding ProductCountDisplay}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyCategoriesText" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66707A" Text="Nessuna categoria creata." />
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="16" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="5">
                        <TextBlock FontWeight="SemiBold" Text="Categoria selezionata" />
                        <TextBox x:Name="SelectedCategoryNameInput" IsEnabled="False" PlaceholderText="Seleziona una categoria" />
                    </StackPanel>
                    <Button x:Name="RenameButton" Grid.Column="1" VerticalAlignment="Bottom" IsEnabled="False" Click="RenameButton_OnClick" Content="Rinomina" />
                    <Button x:Name="DeleteButton" Grid.Column="2" VerticalAlignment="Bottom" IsEnabled="False" Click="DeleteButton_OnClick" Content="Elimina..." />
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Spacing="8">
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="#44515E" TextWrapping="Wrap" />
                <Border x:Name="ErrorPanel" IsVisible="False" Padding="12" CornerRadius="8" Background="#FFF4E5">
                    <TextBlock x:Name="ErrorText" Foreground="#8A4B00" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="24,16" BorderBrush="#D8DDE3" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Foreground="#66707A" Text="Gli ID liberati vengono riutilizzati dalla prossima categoria creata." />
                <Button Grid.Column="1" Click="CloseButton_OnClick" Content="Chiudi" />
            </Grid>
        </Border>
    </Grid>
</Window>
