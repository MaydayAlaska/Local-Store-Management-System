<Window
    x:Class="LocalStoreManagement.Desktop.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Impostazioni"
    Width="680"
    Height="620"
    MinWidth="420"
    MinHeight="440"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="20,18" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1"><StackPanel Spacing="4"><TextBlock FontSize="24" FontWeight="SemiBold" Text="Impostazioni" /><TextBlock Foreground="#66707A" Text="Personalizza il gestionale e i dati del negozio." TextWrapping="Wrap" /></StackPanel></Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"><StackPanel Margin="18" Spacing="18"><StackPanel Spacing="6"><TextBlock FontWeight="SemiBold" Text="Nome negozio" /><TextBox x:Name="ShopNameInput" PlaceholderText="Negozio" /><TextBlock FontSize="12" Foreground="#66707A" Text="Sostituisce la scritta in alto nel menu laterale." TextWrapping="Wrap" /></StackPanel><Border Padding="16" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8"><TextBlock FontWeight="SemiBold" Text="Icona programma" /><Button Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Click="ChooseIconButton_OnClick" Content="Scegli immagine..." /><TextBlock Grid.Row="1" Foreground="#66707A" Text="Usata per la finestra e la barra delle applicazioni." TextWrapping="Wrap" /><TextBlock Grid.Row="2" x:Name="IconFileText" FontSize="12" Foreground="#44515E" TextWrapping="Wrap" Text="Nessuna icona personalizzata." /></Grid></Border><Border Padding="16" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8"><TextBlock FontWeight="SemiBold" Text="Logo negozio" /><Button Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Click="ChooseLogoButton_OnClick" Content="Scegli immagine..." /><TextBlock Grid.Row="1" Foreground="#66707A" Text="Verrà usato in cima alle future esportazioni Excel." TextWrapping="Wrap" /><TextBlock Grid.Row="2" x:Name="LogoFileText" FontSize="12" Foreground="#44515E" TextWrapping="Wrap" Text="Nessun logo selezionato." /></Grid></Border><Border Padding="14" CornerRadius="8" Background="#F5F7F9"><StackPanel Spacing="5"><TextBlock FontWeight="SemiBold" Text="Cartella dati" /><TextBlock x:Name="DataDirectoryText" Foreground="#66707A" TextWrapping="Wrap" /></StackPanel></Border><Border x:Name="ErrorPanel" IsVisible="False" Padding="12" CornerRadius="8" Background="#FFF4E5"><TextBlock x:Name="ErrorText" Foreground="#8A4B00" TextWrapping="Wrap" /></Border></StackPanel></ScrollViewer>
        <Grid Grid.Row="2" Margin="18,10" RowDefinitions="Auto,Auto" RowSpacing="8"><TextBlock Foreground="#66707A" Text="PNG, JPG, BMP e ICO supportati" TextWrapping="Wrap" /><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Click="CancelButton_OnClick" Content="Annulla" /><Button Click="SaveButton_OnClick" Content="Salva impostazioni" /></StackPanel></Grid>
    </Grid>
</Window>
