<Window
    x:Class="LocalStoreManagement.Desktop.ProductEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Prodotto"
    Width="720"
    Height="800"
    MinWidth="620"
    MinHeight="680"
    Background="{DynamicResource AppBackgroundBrush}"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="26,22,26,14">
            <StackPanel Spacing="3">
                <TextBlock x:Name="EditorTitle" FontSize="28" FontWeight="SemiBold" Text="Nuovo prodotto" />
                <TextBlock Classes="Muted" FontSize="12" Text="Anagrafica articolo" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,4,24,20" Spacing="14">
                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="SectionTitle" Text="Identificazione" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="FieldLabel" Text="CODICE INTERNO / SKU *" />
                                <TextBox x:Name="SkuInput" PlaceholderText="ART000001" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="GenerateSkuButton_OnClick" Content="Genera" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="FieldLabel" Text="BARCODE / EAN" />
                            <TextBox x:Name="BarcodeInput" KeyDown="BarcodeInput_OnKeyDown" PlaceholderText="Scansiona o inserisci il codice" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="FieldLabel" Text="NOME PRODOTTO *" />
                            <TextBox x:Name="NameInput" PlaceholderText="Nome articolo" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="SectionTitle" Text="Classificazione" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="FieldLabel" Text="MARCA" />
                                <ComboBox x:Name="BrandInput">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Classes="FieldLabel" Text="CATEGORIA" />
                                <ComboBox x:Name="CategoryInput">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="FieldLabel" Text="VARIANTE" />
                                <TextBox x:Name="VariantInput" PlaceholderText="es. Nero, Classic, Limited" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Classes="FieldLabel" Text="TAGLIA" />
                                <TextBox x:Name="SizeInput" PlaceholderText="es. M, 42, 10 anni" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="Card" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="SectionTitle" Text="Prezzi e note" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="FieldLabel" Text="PREZZO ACQUISTO (€)" />
                                <TextBox x:Name="PurchasePriceInput" PlaceholderText="0,00" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Classes="FieldLabel" Text="PREZZO VENDITA (€)" />
                                <TextBox x:Name="SalePriceInput" PlaceholderText="0,00" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="FieldLabel" Text="NOTE" />
                            <TextBox x:Name="NotesInput" Height="90" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Informazioni aggiuntive..." />
                        </StackPanel>

                        <CheckBox x:Name="IsActiveInput" IsChecked="True" Content="Prodotto attivo" />
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel" Classes="InsetCard" Padding="12" Background="{DynamicResource AppOrangeSoftBrush}" IsVisible="False">
                    <TextBlock x:Name="ErrorText" Foreground="#A45C00" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,14,24,18" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Classes="Muted" VerticalAlignment="Center" FontSize="11" Text="* campo obbligatorio" />
                <Button Grid.Column="1" Click="CancelButton_OnClick" Content="Annulla" />
                <Button Grid.Column="2" Classes="Primary" Click="SaveButton_OnClick" Content="Salva prodotto" />
            </Grid>
        </Border>
    </Grid>
</Window>
