<Window
    x:Class="LocalStoreManagement.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Local Store Management System"
    Width="1100"
    Height="720"
    MinWidth="900"
    MinHeight="600">

    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,*">
        <Border Grid.RowSpan="2" Padding="20" Background="#17191C">
            <StackPanel Spacing="12">
                <TextBlock FontSize="21" FontWeight="Bold" Foreground="White" Text="Negozio" />
                <TextBlock Margin="0,0,0,16" Foreground="#AEB4BC" Text="Gestione locale" />

                <Button HorizontalAlignment="Stretch" Content="Dashboard" />
                <Button HorizontalAlignment="Stretch" Content="Prodotti" IsEnabled="False" />
                <Button HorizontalAlignment="Stretch" Content="Magazzino" IsEnabled="False" />
                <Button HorizontalAlignment="Stretch" Content="Inventario" IsEnabled="False" />
                <Button HorizontalAlignment="Stretch" Content="Etichette" IsEnabled="False" />
                <Button HorizontalAlignment="Stretch" Content="Movimenti" IsEnabled="False" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="28,22" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="Dashboard" />
                    <TextBlock Foreground="#66707A" Text="Applicazione desktop Windows + Linux" />
                </StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="14" Background="#E9F7EE">
                    <TextBlock Foreground="#18733A" Text="Database locale attivo" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel Margin="28" Spacing="18">
                <Border Padding="22" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Scansione rapida" />
                        <TextBlock Foreground="#66707A" Text="Collega lo scanner USB e scansiona un codice. Lo scanner viene letto come tastiera HID." />
                        <TextBox
                            x:Name="BarcodeInput"
                            FontSize="20"
                            KeyDown="BarcodeInput_OnKeyDown"
                            Watermark="Scansiona codice a barre e premi Invio" />
                        <TextBlock x:Name="LastScanText" Foreground="#44515E" Text="Nessun codice scansionato." />
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                    <Border Padding="22" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Magazzino" />
                            <TextBlock FontSize="34" FontWeight="Bold" Text="0" />
                            <TextBlock Foreground="#66707A" Text="Prodotti registrati" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="22" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Inventario" />
                            <TextBlock FontSize="34" FontWeight="Bold" Text="Pronto" />
                            <TextBlock Foreground="#66707A" Text="Modulo inventario in preparazione" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Padding="18" CornerRadius="10" Background="#F5F7F9">
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Text="Dati applicazione" />
                        <TextBlock x:Name="DatabasePathText" TextWrapping="Wrap" Foreground="#66707A" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
