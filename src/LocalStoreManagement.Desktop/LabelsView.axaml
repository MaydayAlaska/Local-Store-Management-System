<UserControl
    x:Class="LocalStoreManagement.Desktop.LabelsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LocalStoreManagement.Desktop.Controls"
    x:CompileBindings="False">

    <Grid Margin="24,8,24,24" RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="Muted" VerticalAlignment="Center" FontSize="12" Text="Seleziona un prodotto, controlla l'anteprima e invia l'etichetta alla stampante di sistema." />
            <Border Grid.Column="1" Classes="StatusPill">
                <TextBlock x:Name="BackendText" FontSize="11" FontWeight="SemiBold" Foreground="#187A36" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="370,*" ColumnSpacing="16">
            <Border Classes="Card" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBox
                        x:Name="LabelSearchInput"
                        Classes="SearchBox"
                        TextChanged="LabelSearchInput_OnTextChanged"
                        PlaceholderText="Cerca prodotto, SKU, barcode, marca o categoria..." />

                    <Border Grid.Row="1" Classes="InsetCard" Padding="4">
                        <Grid>
                            <ListBox x:Name="ProductsList" SelectionChanged="ProductsList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10,8" ColumnDefinitions="92,*,76">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Sku}" />
                                                <TextBlock Classes="Muted" FontSize="11" Text="{Binding Barcode}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Classes="Muted" FontSize="11" Text="{Binding DetailsDisplay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SalePriceDisplay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyProductsText" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Muted" Text="Nessun prodotto trovato." />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="14">
                    <Border Classes="Card" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="SectionTitle" Text="Anteprima etichetta" />
                                <TextBlock x:Name="SymbologyText" Grid.Column="1" Classes="Muted" VerticalAlignment="Center" FontSize="11" />
                            </Grid>

                            <Border
                                x:Name="LabelPreviewContainer"
                                Width="430"
                                Height="258"
                                HorizontalAlignment="Center"
                                Padding="18"
                                Background="White"
                                BorderBrush="#D7D7DE"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                                    <TextBlock x:Name="PreviewProductName" FontSize="20" FontWeight="Bold" Foreground="Black" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PreviewDetails" Grid.Row="1" Margin="0,2,0,8" FontSize="12" Foreground="#6E6E73" TextTrimming="CharacterEllipsis" />
                                    <controls:BarcodePreviewControl x:Name="BarcodePreview" Grid.Row="2" MinHeight="80" Margin="0,4" />
                                    <TextBlock x:Name="PreviewBarcodeText" Grid.Row="3" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="Black" />
                                    <Grid Grid.Row="4" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="PreviewSku" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="Black" />
                                        <TextBlock x:Name="PreviewPrice" Grid.Column="1" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="Black" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="Card" Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="SectionTitle" Text="Stampa" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="STAMPANTE" />
                                    <ComboBox x:Name="PrinterInput" MinWidth="300" SelectionChanged="PrinterInput_OnSelectionChanged" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshPrintersButton_OnClick" Content="Aggiorna" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="COPIE" />
                                    <NumericUpDown x:Name="CopiesInput" Minimum="1" Maximum="100" Increment="1" Value="1" FormatString="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="LARGHEZZA (MM)" />
                                    <NumericUpDown x:Name="WidthInput" Minimum="20" Maximum="120" Increment="1" Value="50" FormatString="0" ValueChanged="LabelSizeInput_OnValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Classes="FieldLabel" Text="ALTEZZA (MM)" />
                                    <NumericUpDown x:Name="HeightInput" Minimum="15" Maximum="200" Increment="1" Value="30" FormatString="0" ValueChanged="LabelSizeInput_OnValueChanged" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="DriverHelpText" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                            <Border x:Name="StatusPanel" Classes="InsetCard" Padding="11">
                                <TextBlock x:Name="StatusText" FontSize="12" Text="Seleziona un prodotto e una stampante." TextWrapping="Wrap" />
                            </Border>
                            <Button x:Name="PrintButton" Classes="Primary" HorizontalAlignment="Stretch" Click="PrintButton_OnClick" Content="Stampa etichetta" IsEnabled="False" />
                            <TextBlock Classes="Muted" FontSize="10" TextWrapping="Wrap" Text="Il barcode usa EAN-13 quando il codice è valido; negli altri casi usa Code 128." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
