<Window
    x:Class="LocalStoreManagement.Desktop.ExportWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Backup ed esportazione"
    Width="900"
    Height="800"
    MinWidth="520"
    MinHeight="520"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="20,18" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1"><StackPanel Spacing="4"><TextBlock FontSize="24" FontWeight="SemiBold" Text="Backup ed esportazione" TextWrapping="Wrap" /><TextBlock Foreground="#66707A" TextWrapping="Wrap" Text="Salva una copia del database oppure esporta l'inventario in Excel o PDF." /></StackPanel></Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="18" Spacing="16">
                <Border Padding="16" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Backup database" /><Button Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Click="BackupButton_OnClick" Content="Crea backup" /><TextBlock Grid.Row="1" Foreground="#66707A" TextWrapping="Wrap" Text="Crea una copia consistente del database SQLite nella cartella Backups." /><TextBlock Grid.Row="2" x:Name="BackupStatusText" FontSize="12" Foreground="#44515E" TextWrapping="Wrap" Text="Nessun backup creato in questa sessione." /></Grid></Border>
                <Border Padding="16" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1"><Grid ColumnDefinitions="2*,*" ColumnSpacing="14"><StackPanel Spacing="4"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Formato esportazione" /><TextBlock Foreground="#66707A" TextWrapping="Wrap" Text="Scegli il formato da usare sia per l'esportazione completa sia per quella parziale." /></StackPanel><ComboBox x:Name="ExportFormatInput" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0"><ComboBoxItem Content="Excel (.xlsx)" /><ComboBoxItem Content="PDF (.pdf)" /></ComboBox></Grid></Border>
                <Border Padding="16" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="4"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Esportazione completa" /><TextBlock Foreground="#66707A" TextWrapping="Wrap" Text="Esporta tutto l'inventario in un unico file, diviso in sezioni per marca ordinate alfabeticamente. In Excel viene creato un solo foglio." /></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Click="FullExportButton_OnClick" Content="Esporta tutto..." /></Grid><TextBlock x:Name="FullExportSummaryText" FontSize="12" Foreground="#44515E" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Padding="16" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1"><StackPanel Spacing="14"><StackPanel Spacing="4"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Esportazione parziale" /><TextBlock Foreground="#66707A" TextWrapping="Wrap" Text="Seleziona una o più marche e/o categorie. Le selezioni della stessa colonna sono alternative; se scegli sia marche sia categorie vengono applicati entrambi i filtri." /></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="8"><TextBlock FontWeight="SemiBold" Text="Marche" /><Border Height="220" Padding="10" CornerRadius="8" Background="#F5F7F9"><ScrollViewer><ItemsControl x:Name="BrandFilterList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="2,4" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock FontWeight="SemiBold" Text="Categorie" /><Border Height="220" Padding="10" CornerRadius="8" Background="#F5F7F9"><ScrollViewer><ItemsControl x:Name="CategoryFilterList"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="2,4" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border></StackPanel></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock x:Name="PartialExportSummaryText" VerticalAlignment="Center" FontSize="12" Foreground="#44515E" TextWrapping="Wrap" Text="Seleziona almeno una marca o una categoria." /><Button Grid.Column="1" Click="PartialExportButton_OnClick" Content="Esporta selezione..." /></Grid></StackPanel></Border>
                <Border x:Name="ErrorPanel" IsVisible="False" Padding="12" CornerRadius="8" Background="#FFF4E5"><TextBlock x:Name="ErrorText" Foreground="#8A4B00" TextWrapping="Wrap" /></Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="18,10" RowDefinitions="Auto,Auto" RowSpacing="8"><TextBlock x:Name="DataDirectoryText" Foreground="#66707A" TextWrapping="Wrap" /><Button Grid.Row="1" HorizontalAlignment="Right" Click="CloseButton_OnClick" Content="Chiudi" /></Grid>
    </Grid>
</Window>
