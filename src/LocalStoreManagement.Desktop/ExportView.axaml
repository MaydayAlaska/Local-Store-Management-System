<UserControl
    x:Class="LocalStoreManagement.Desktop.ExportView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False">

    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="16,8,16,20" Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Border Classes="Card" Padding="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock Classes="SectionTitle" Text="Backup database" />
                        <TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="Crea una copia consistente del database SQLite nella cartella Backups." />
                        <TextBlock x:Name="BackupStatusText" Classes="Muted" FontSize="11" TextWrapping="Wrap" Text="Nessun backup creato in questa sessione." />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Click="BackupButton_OnClick" Content="Crea backup" />
                </Grid>
            </Border>

            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="SectionTitle" Text="Esportazione inventario" />
                            <TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="Scegli Excel o PDF e poi esporta tutto l'inventario oppure applica filtri." />
                        </StackPanel>
                        <ComboBox x:Name="ExportFormatInput" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="Excel (.xlsx)" />
                            <ComboBoxItem Content="PDF (.pdf)" />
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="5">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Esportazione completa" />
                            <TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="Tutto l'inventario in un unico file, suddiviso per marche in ordine alfabetico. Excel usa un solo foglio." />
                            <TextBlock x:Name="FullExportSummaryText" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="Primary" VerticalAlignment="Center" Click="FullExportButton_OnClick" Content="Esporta tutto…" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock Classes="SectionTitle" Text="Esportazione parziale" />
                        <TextBlock Classes="Muted" FontSize="12" TextWrapping="Wrap" Text="Seleziona una o più marche e/o categorie. All'interno della stessa colonna vale OR; tra marche e categorie vale AND." />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="FieldLabel" Text="MARCHE" />
                            <Border Height="230" Classes="InsetCard">
                                <ScrollViewer Padding="12">
                                    <ItemsControl x:Name="BrandFilterList">
                                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="2,5" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Classes="FieldLabel" Text="CATEGORIE" />
                            <Border Height="230" Classes="InsetCard">
                                <ScrollViewer Padding="12">
                                    <ItemsControl x:Name="CategoryFilterList">
                                        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="2,5" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock x:Name="PartialExportSummaryText" Classes="Muted" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Text="Seleziona almeno una marca o una categoria." />
                        <Button Grid.Column="1" Classes="Primary" Click="PartialExportButton_OnClick" Content="Esporta selezione…" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" IsVisible="False" Foreground="#C12820" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="DataDirectoryText" Classes="Muted" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
