<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Palette ispirata alle superfici pulite e neutre delle app desktop moderne. -->
  <Styles.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="AppChromeBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="AppSidebarBrush" Color="#EBEBF0" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#F8F8FA" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E1E1E8" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#007AFF" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#0A6FE8" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#EAF3FF" />
    <SolidColorBrush x:Key="AppGreenBrush" Color="#34C759" />
    <SolidColorBrush x:Key="AppGreenSoftBrush" Color="#EAF8EE" />
    <SolidColorBrush x:Key="AppOrangeBrush" Color="#FF9500" />
    <SolidColorBrush x:Key="AppOrangeSoftBrush" Color="#FFF5E8" />
    <SolidColorBrush x:Key="AppRedBrush" Color="#FF3B30" />
    <SolidColorBrush x:Key="AppRedSoftBrush" Color="#FFF0EF" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.Primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
  </Style>

  <Style Selector="Button.Success">
    <Setter Property="Background" Value="{DynamicResource AppGreenSoftBrush}" />
    <Setter Property="Foreground" Value="#187A36" />
    <Setter Property="BorderBrush" Value="#CBEFD4" />
  </Style>

  <Style Selector="Button.Warning">
    <Setter Property="Background" Value="{DynamicResource AppOrangeSoftBrush}" />
    <Setter Property="Foreground" Value="#A45C00" />
    <Setter Property="BorderBrush" Value="#F2DAB8" />
  </Style>

  <Style Selector="Button.Danger">
    <Setter Property="Background" Value="{DynamicResource AppRedSoftBrush}" />
    <Setter Property="Foreground" Value="#C12820" />
    <Setter Property="BorderBrush" Value="#F3D0CD" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="#D7D7DE" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBox.SearchBox">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#D7D7DE" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="#08000000" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
  </Style>

  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>

  <Style Selector="Border.InsetCard">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Border.StatusPill">
    <Setter Property="Background" Value="{DynamicResource AppGreenSoftBrush}" />
    <Setter Property="BorderBrush" Value="#CBEFD4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="11,5" />
  </Style>

  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.FieldLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.ColumnHeader">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>

  <Style Selector="Button.SidebarNav">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.SidebarNav:pointerover">
    <Setter Property="Background" Value="#10000000" />
  </Style>
  <Style Selector="Button.SidebarNav.Selected">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.SidebarIcon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style Selector="Button.SidebarIcon:pointerover">
    <Setter Property="Background" Value="#10000000" />
  </Style>
  <Style Selector="Button.SidebarIcon.Selected">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="Button.TitleTraffic">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="MinWidth" Value="13" />
    <Setter Property="MinHeight" Value="13" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <Style Selector="Button.TitleTraffic:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
