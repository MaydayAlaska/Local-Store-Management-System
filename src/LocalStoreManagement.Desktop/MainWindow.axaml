<Window
    x:Class="LocalStoreManagement.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Local Store Management System"
    Width="1260"
    Height="820"
    MinWidth="1040"
    MinHeight="680"
    Background="{DynamicResource AppBackgroundBrush}">

    <Grid ColumnDefinitions="248,*" RowDefinitions="Auto,*">
        <!-- Sidebar -->
        <Border
            Grid.RowSpan="2"
            Margin="12,10,0,12"
            Padding="12"
            Background="{DynamicResource AppSidebarBrush}"
            BorderBrush="#D7D7DE"
            BorderThickness="1"
            CornerRadius="18">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Margin="8,6,8,20" Spacing="4">
                    <TextBlock
                        x:Name="ShopNameText"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextBrush}"
                        Text="Negozio"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="Muted"
                        FontSize="12"
                        Text="Gestione locale · offline" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock
                        Margin="12,0,12,6"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppSecondaryTextBrush}"
                        Text="GESTIONE" />

                    <Button x:Name="DashboardNavButton" Classes="SidebarNav Selected" Click="DashboardButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Width="20" HorizontalAlignment="Center" FontSize="16" Text="⌂" />
                            <TextBlock VerticalAlignment="Center" Text="Dashboard" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProductsNavButton" Classes="SidebarNav" Click="ProductsButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Width="20" HorizontalAlignment="Center" FontSize="15" Text="▦" />
                            <TextBlock VerticalAlignment="Center" Text="Prodotti" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WarehouseNavButton" Classes="SidebarNav" Click="WarehouseButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Width="20" HorizontalAlignment="Center" FontSize="16" Text="⇅" />
                            <TextBlock VerticalAlignment="Center" Text="Magazzino" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BrandsNavButton" Classes="SidebarNav" Click="BrandsButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Width="20" HorizontalAlignment="Center" FontSize="14" Text="◇" />
                            <TextBlock VerticalAlignment="Center" Text="Marche" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CategoriesNavButton" Classes="SidebarNav" Click="CategoriesButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Width="20" HorizontalAlignment="Center" FontSize="15" Text="◌" />
                            <TextBlock VerticalAlignment="Center" Text="Categorie" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LabelsNavButton" Classes="SidebarNav" Click="LabelsButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Width="20" HorizontalAlignment="Center" FontSize="15" Text="▤" />
                            <TextBlock VerticalAlignment="Center" Text="Etichette" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MovementsNavButton" Classes="SidebarNav" Click="MovementsButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Width="20" HorizontalAlignment="Center" FontSize="15" Text="↕" />
                            <TextBlock VerticalAlignment="Center" Text="Movimenti" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportNavButton" Classes="SidebarNav" Click="ExportButton_OnClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Width="20" HorizontalAlignment="Center" FontSize="15" Text="⇩" />
                            <TextBlock VerticalAlignment="Center" Text="Esportazione" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="2" Margin="8,14,4,2" ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSecondaryTextBrush}" Text="LOCAL STORE" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource AppSecondaryTextBrush}" Text="Windows · Linux" />
                    </StackPanel>
                    <Button
                        x:Name="SettingsNavButton"
                        Grid.Column="1"
                        Classes="SidebarIcon"
                        Click="SettingsButton_OnClick"
                        Content="⚙"
                        ToolTip.Tip="Impostazioni" />
                </Grid>
            </Grid>
        </Border>

        <!-- Header -->
        <Border Grid.Column="1" Margin="24,14,24,0" Padding="4,2,4,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock
                        x:Name="PageTitle"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextBrush}"
                        Text="Dashboard" />
                    <TextBlock
                        x:Name="PageSubtitle"
                        Classes="Muted"
                        FontSize="13"
                        Text="Ricerca, scansione e giacenza rapida" />
                </StackPanel>
                <Border Grid.Column="1" Classes="StatusPill" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="7" Height="7" VerticalAlignment="Center" Background="{DynamicResource AppGreenBrush}" CornerRadius="4" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#187A36" Text="Database locale attivo" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Grid.Column="1">
            <ScrollViewer x:Name="DashboardPanel">
                <StackPanel Margin="24,8,24,24" Spacing="16">
                    <Border Classes="Card" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="SectionTitle" Text="Cerca o scansiona prodotto" />
                                    <TextBlock
                                        Classes="Muted"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Text="Scansiona barcode/SKU oppure cerca per nome. La scansione apre la scheda senza modificare la giacenza." />
                                </StackPanel>
                                <Border Grid.Column="1" Padding="10,5" Background="{DynamicResource AppAccentSoftBrush}" CornerRadius="999" VerticalAlignment="Top">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentBrush}" Text="Scanner HID pronto" />
                                </Border>
                            </Grid>

                            <TextBox
                                x:Name="DashboardSearchInput"
                                Classes="SearchBox"
                                FontSize="16"
                                TextChanged="DashboardSearchInput_OnTextChanged"
                                KeyDown="DashboardSearchInput_OnKeyDown"
                                PlaceholderText="Scansiona barcode/SKU o digita il nome del prodotto..." />

                            <TextBlock
                                x:Name="DashboardSearchStatusText"
                                Classes="Muted"
                                FontSize="11"
                                Text="Scansiona un codice oppure cerca un prodotto per nome, SKU o barcode." />

                            <Border Classes="InsetCard" Padding="4">
                                <ListBox
                                    x:Name="DashboardProductsList"
                                    Height="148"
                                    SelectionChanged="DashboardProductsList_OnSelectionChanged"
                                    DoubleTapped="DashboardProductsList_OnDoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,8" ColumnDefinitions="*,170,140,70">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Classes="Muted" FontSize="11" Text="{Binding DetailsDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Brand}" />
                                                    <TextBlock Classes="Muted" FontSize="11" Text="{Binding Category}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Sku}" />
                                                    <TextBlock Classes="Muted" HorizontalAlignment="Right" FontSize="11" Text="{Binding Barcode}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="20" FontWeight="SemiBold" Text="{Binding StockQuantity}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Border x:Name="DashboardProductDetailsPanel" Classes="InsetCard" IsVisible="False" Padding="18">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="DashboardProductNameText" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock x:Name="DashboardProductCodeSummaryText" Classes="Muted" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="Success" MinWidth="72" FontSize="16" Click="DashboardIncomingButton_OnClick" Content="+1" />
                                        <Button x:Name="DashboardOutgoingButton" Grid.Column="2" Classes="Warning" MinWidth="72" FontSize="16" Click="DashboardOutgoingButton_OnClick" Content="−1" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="14">
                                        <StackPanel>
                                            <TextBlock Classes="FieldLabel" Text="GIACENZA" />
                                            <TextBlock x:Name="DashboardStockText" FontSize="30" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="FieldLabel" Text="STATO" />
                                            <TextBlock x:Name="DashboardStatusText" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Classes="FieldLabel" Text="MARCA" />
                                            <TextBlock x:Name="DashboardBrandText" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Classes="FieldLabel" Text="CATEGORIA" />
                                            <TextBlock x:Name="DashboardCategoryText" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1">
                                            <TextBlock Classes="FieldLabel" Text="SKU" />
                                            <TextBlock x:Name="DashboardSkuText" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Classes="FieldLabel" Text="BARCODE / EAN" />
                                            <TextBlock x:Name="DashboardBarcodeText" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock Classes="FieldLabel" Text="VARIANTE" />
                                            <TextBlock x:Name="DashboardVariantText" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3">
                                            <TextBlock Classes="FieldLabel" Text="TAGLIA" />
                                            <TextBlock x:Name="DashboardSizeText" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock Classes="FieldLabel" Text="PREZZO ACQUISTO" />
                                            <TextBlock x:Name="DashboardPurchasePriceText" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Classes="FieldLabel" Text="PREZZO VENDITA" />
                                            <TextBlock x:Name="DashboardSalePriceText" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Classes="FieldLabel" Text="ID PRODOTTO" />
                                            <TextBlock x:Name="DashboardProductIdText" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="FieldLabel" Text="NOTE" />
                                        <TextBlock x:Name="DashboardNotesText" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="DashboardMovementStatusText" Classes="Muted" VerticalAlignment="Center" FontSize="12" />
                                        <Button Grid.Column="1" Click="DashboardEditProductButton_OnClick" Content="Modifica scheda" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Classes="Card" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="Muted" FontSize="12" FontWeight="SemiBold" Text="ANAGRAFICA" />
                                    <TextBlock x:Name="ProductsCountText" FontSize="38" FontWeight="SemiBold" Text="0" />
                                    <TextBlock Classes="Muted" FontSize="12" Text="Prodotti registrati" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="44" Height="44" Background="{DynamicResource AppAccentSoftBrush}" CornerRadius="14" VerticalAlignment="Top">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AppAccentBrush}" Text="▦" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="Card" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="Muted" FontSize="12" FontWeight="SemiBold" Text="MAGAZZINO" />
                                    <TextBlock x:Name="TotalStockText" FontSize="38" FontWeight="SemiBold" Text="0" />
                                    <TextBlock Classes="Muted" FontSize="12" Text="Pezzi totali in giacenza" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="44" Height="44" Background="{DynamicResource AppGreenSoftBrush}" CornerRadius="14" VerticalAlignment="Top">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#187A36" Text="⇅" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Classes="InsetCard" Padding="14,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock VerticalAlignment="Center" FontSize="16" Text="●" Foreground="{DynamicResource AppGreenBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Dati applicazione" />
                                <TextBlock x:Name="DatabasePathText" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Prodotti -->
            <Grid x:Name="ProductsPanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="14" Margin="24,8,24,24">
                <Border Classes="Card" Padding="14">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBox
                            x:Name="ProductSearchInput"
                            Classes="SearchBox"
                            TextChanged="ProductSearchInput_OnTextChanged"
                            PlaceholderText="Cerca per SKU, barcode, nome, marca, categoria, variante o taglia..." />
                        <Button Grid.Column="1" Click="EditProductButton_OnClick" Content="Modifica selezionato" />
                        <Button Grid.Column="2" Classes="Primary" Click="NewProductButton_OnClick" Content="+ Nuovo prodotto" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="Card" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Padding="16,12" Background="{DynamicResource AppSurfaceMutedBrush}" CornerRadius="18,18,0,0">
                            <Grid ColumnDefinitions="120,*,150,150,95,70,90">
                                <TextBlock Classes="ColumnHeader" Text="CODICE" />
                                <TextBlock Grid.Column="1" Classes="ColumnHeader" Text="PRODOTTO" />
                                <TextBlock Grid.Column="2" Classes="ColumnHeader" Text="MARCA" />
                                <TextBlock Grid.Column="3" Classes="ColumnHeader" Text="CATEGORIA" />
                                <TextBlock Grid.Column="4" Classes="ColumnHeader" HorizontalAlignment="Right" Text="PREZZO" />
                                <TextBlock Grid.Column="5" Classes="ColumnHeader" HorizontalAlignment="Right" Text="Q.TÀ" />
                                <TextBlock Grid.Column="6" Classes="ColumnHeader" HorizontalAlignment="Right" Text="STATO" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="ProductsList" Margin="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,10" ColumnDefinitions="120,*,150,150,95,70,90">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Sku}" />
                                                <TextBlock Classes="Muted" FontSize="11" Text="{Binding Barcode}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Classes="Muted" FontSize="11" Text="{Binding DetailsDisplay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Brand}" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Category}" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding SalePriceDisplay}" />
                                            <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding StockQuantity}" />
                                            <TextBlock Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding StatusDisplay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyProductsPanel" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <TextBlock FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Text="Nessun prodotto" />
                                <TextBlock Classes="Muted" HorizontalAlignment="Center" Text="Aggiungi il primo prodotto o modifica la ricerca." />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Magazzino -->
            <Grid x:Name="WarehousePanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="14" Margin="24,8,24,24">
                <Border Classes="Card" Padding="14">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                        <TextBox
                            x:Name="WarehouseSearchInput"
                            Classes="SearchBox"
                            TextChanged="WarehouseSearchInput_OnTextChanged"
                            PlaceholderText="Cerca o scansiona SKU/barcode, prodotto, marca o categoria..." />
                        <Button Grid.Column="1" Classes="Success" Click="IncomingButton_OnClick" Content="+ Carico" />
                        <Button Grid.Column="2" Classes="Warning" Click="OutgoingButton_OnClick" Content="− Scarico" />
                        <Button Grid.Column="3" Click="AdjustmentButton_OnClick" Content="Rettifica" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="Card" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Padding="16,12" Background="{DynamicResource AppSurfaceMutedBrush}" CornerRadius="18,18,0,0">
                            <Grid ColumnDefinitions="125,*,170,160,90">
                                <TextBlock Classes="ColumnHeader" Text="CODICE" />
                                <TextBlock Grid.Column="1" Classes="ColumnHeader" Text="PRODOTTO" />
                                <TextBlock Grid.Column="2" Classes="ColumnHeader" Text="MARCA" />
                                <TextBlock Grid.Column="3" Classes="ColumnHeader" Text="CATEGORIA" />
                                <TextBlock Grid.Column="4" Classes="ColumnHeader" HorizontalAlignment="Right" Text="GIACENZA" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="WarehouseProductsList" Margin="4" DoubleTapped="WarehouseProductsList_OnDoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,10" ColumnDefinitions="125,*,170,160,90">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Sku}" />
                                                <TextBlock Classes="Muted" FontSize="11" Text="{Binding Barcode}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Classes="Muted" FontSize="11" Text="{Binding DetailsDisplay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Brand}" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Category}" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold" Text="{Binding StockQuantity}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyWarehouseText" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Muted" Text="Nessun prodotto trovato." />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Movimenti -->
            <Grid x:Name="MovementsPanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="14" Margin="24,8,24,24">
                <Border Classes="Card" Padding="14">
                    <TextBox
                        x:Name="MovementSearchInput"
                        Classes="SearchBox"
                        TextChanged="MovementSearchInput_OnTextChanged"
                        PlaceholderText="Filtra storico per SKU, barcode, prodotto, marca, categoria o nota..." />
                </Border>

                <Border Grid.Row="1" Classes="Card" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <Border Padding="16,12" Background="{DynamicResource AppSurfaceMutedBrush}" CornerRadius="18,18,0,0">
                            <Grid ColumnDefinitions="145,110,120,*,130,90,90">
                                <TextBlock Classes="ColumnHeader" Text="DATA" />
                                <TextBlock Grid.Column="1" Classes="ColumnHeader" Text="TIPO" />
                                <TextBlock Grid.Column="2" Classes="ColumnHeader" Text="CODICE" />
                                <TextBlock Grid.Column="3" Classes="ColumnHeader" Text="PRODOTTO / NOTA" />
                                <TextBlock Grid.Column="4" Classes="ColumnHeader" Text="MARCA" />
                                <TextBlock Grid.Column="5" Classes="ColumnHeader" HorizontalAlignment="Right" Text="VARIAZIONE" />
                                <TextBlock Grid.Column="6" Classes="ColumnHeader" HorizontalAlignment="Right" Text="DOPO" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="MovementsList" Margin="4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,10" ColumnDefinitions="145,110,120,*,130,90,90">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding CreatedAtDisplay}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding TypeDisplay}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Sku}" />
                                            <StackPanel Grid.Column="3" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ProductName}" />
                                                <TextBlock Classes="Muted" FontSize="11" Text="{Binding Note}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Brand}" />
                                            <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding QuantityDisplay}" />
                                            <TextBlock Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding StockAfter}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyMovementsText" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Muted" Text="Nessun movimento registrato." />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
