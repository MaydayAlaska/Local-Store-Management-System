<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Window-level acrylic: supported platforms render the desktop/app behind the UI blurred.
       Unsupported compositors fall back to the opaque theme background. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="TransparencyLevelHint" Value="AcrylicBlur, Blur" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource AppFallbackBackgroundBrush}" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <!-- Frosted controls -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="15,8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="Button.Primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
  </Style>

  <Style Selector="Button.Success">
    <Setter Property="Background" Value="{DynamicResource AppGreenSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppGreenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppGreenBorderBrush}" />
  </Style>

  <Style Selector="Button.Warning">
    <Setter Property="Background" Value="{DynamicResource AppOrangeSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppOrangeTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppOrangeBorderBrush}" />
  </Style>

  <Style Selector="Button.Danger">
    <Setter Property="Background" Value="{DynamicResource AppRedSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppRedTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppRedBorderBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
  </Style>

  <Style Selector="TextBox.SearchBox">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="15,10" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>

  <!-- Lists float directly over the glass panels. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
  </Style>

  <!-- Main glass layers: translucency + bright edge + soft depth. -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="BoxShadow" Value="0 16 40 -12 #3308172E, inset 0 1 0 0 #35FFFFFF" />
  </Style>

  <Style Selector="Border.InsetCard">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #2EFFFFFF" />
  </Style>

  <Style Selector="Border.StatusPill">
    <Setter Property="Background" Value="{DynamicResource AppGreenSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppGreenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="BoxShadow" Value="0 8 22 -12 #2608172E" />
  </Style>

  <Style Selector="TextBlock.Muted">
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.FieldLabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.ColumnHeader">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
  </Style>

  <!-- Sidebar becomes a floating glass rail. -->
  <Style Selector="Button.SidebarNav">
    <Setter Property="MinHeight" Value="43" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.SidebarNav:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.SidebarNav.Selected">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.SidebarIcon">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="MinWidth" Value="42" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.SidebarIcon:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.SidebarIcon.Selected">
    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Custom title bar stays visually light so the acrylic backdrop remains visible. -->
  <Style Selector="Button.TitleBarButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.TitleBarButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
  </Style>
  <Style Selector="Button.TitleBarButton:pressed">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="Button.TitleBarButton.TitleBarClose:pointerover">
    <Setter Property="Background" Value="#D93A2B" />
    <Setter Property="Foreground" Value="White" />
  </Style>
</Styles>
