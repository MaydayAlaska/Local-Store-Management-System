<UserControl
    x:Class="LocalStoreManagement.Desktop.BrandsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False">

    <Grid Margin="24,8,24,24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14" MaxWidth="1040" HorizontalAlignment="Stretch">
        <Border Classes="Card" Padding="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="6">
                    <TextBlock Classes="SectionTitle" Text="Nuova marca" />
                    <TextBox x:Name="NewBrandNameInput" MinWidth="360" Classes="SearchBox" PlaceholderText="Nome della nuova marca" />
                </StackPanel>
                <Button Grid.Column="1" Classes="Primary" VerticalAlignment="Bottom" Click="CreateButton_OnClick" Content="+ Crea marca" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="Card" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="16,12" Background="{DynamicResource AppSurfaceMutedBrush}" CornerRadius="18,18,0,0">
                    <Grid ColumnDefinitions="70,*,150">
                        <TextBlock Classes="ColumnHeader" Text="ID" />
                        <TextBlock Grid.Column="1" Classes="ColumnHeader" Text="MARCA" />
                        <TextBlock Grid.Column="2" Classes="ColumnHeader" HorizontalAlignment="Right" Text="PRODOTTI" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListBox x:Name="BrandsList" Margin="4" SelectionChanged="BrandsList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,10" ColumnDefinitions="70,*,150">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Id}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="Muted" Text="{Binding ProductCountDisplay}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyBrandsText" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="Muted" Text="Nessuna marca creata." />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="Card" Padding="18">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="6">
                    <TextBlock Classes="FieldLabel" Text="MARCA SELEZIONATA" />
                    <TextBox x:Name="SelectedBrandNameInput" IsEnabled="False" PlaceholderText="Seleziona una marca dalla lista" />
                </StackPanel>
                <Button x:Name="RenameButton" Grid.Column="1" VerticalAlignment="Bottom" IsEnabled="False" Click="RenameButton_OnClick" Content="Rinomina" />
                <Button x:Name="DeleteButton" Grid.Column="2" Classes="Danger" VerticalAlignment="Bottom" IsEnabled="False" Click="DeleteButton_OnClick" Content="Elimina…" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock x:Name="StatusText" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" IsVisible="False" Foreground="#C12820" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="Muted" FontSize="10" Text="Gli ID liberati vengono riutilizzati dalla prossima marca creata." />
        </StackPanel>
    </Grid>
</UserControl>
