<Window
    x:Class="LocalStoreManagement.Desktop.ExportWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:CompileBindings="False"
    Title="Backup ed esportazione"
    Width="900"
    Height="760"
    MinWidth="760"
    MinHeight="620"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="24,20" BorderBrush="#D8DDE3" BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Backup ed esportazione" />
                <TextBlock Foreground="#66707A" Text="Salva una copia del database oppure esporta l'inventario in Excel." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24" Spacing="20">
                <Border Padding="18" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Backup database" />
                        <Button Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Click="BackupButton_OnClick" Content="Crea backup" />
                        <TextBlock Grid.Row="1" Foreground="#66707A" Text="Crea una copia consistente del database SQLite nella cartella Backups." />
                        <TextBlock Grid.Row="2" x:Name="BackupStatusText" FontSize="12" Foreground="#44515E" TextWrapping="Wrap" Text="Nessun backup creato in questa sessione." />
                    </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Esportazione completa" />
                                <TextBlock Foreground="#66707A" TextWrapping="Wrap" Text="Un unico foglio Excel con tutto l'inventario, diviso in sezioni per marca ordinate alfabeticamente." />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" Click="FullExportButton_OnClick" Content="Esporta tutto..." />
                        </Grid>
                        <TextBlock x:Name="FullExportSummaryText" FontSize="12" Foreground="#44515E" />
                    </StackPanel>
                </Border>

                <Border Padding="18" CornerRadius="10" BorderBrush="#D8DDE3" BorderThickness="1">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Esportazione parziale" />
                            <TextBlock Foreground="#66707A" TextWrapping="Wrap" Text="Seleziona una o più marche e/o categorie. Le selezioni della stessa colonna sono alternative; se scegli sia marche sia categorie vengono applicati entrambi i filtri." />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Marche" />
                                <Border Height="220" Padding="10" CornerRadius="8" Background="#F5F7F9">
                                    <ScrollViewer>
                                        <ItemsControl x:Name="BrandFilterList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="2,4" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Categorie" />
                                <Border Height="220" Padding="10" CornerRadius="8" Background="#F5F7F9">
                                    <ScrollViewer>
                                        <ItemsControl x:Name="CategoryFilterList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="2,4" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="PartialExportSummaryText" VerticalAlignment="Center" FontSize="12" Foreground="#44515E" Text="Seleziona almeno una marca o una categoria." />
                            <Button Grid.Column="1" Click="PartialExportButton_OnClick" Content="Esporta selezione..." />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel" IsVisible="False" Padding="12" CornerRadius="8" Background="#FFF4E5">
                    <TextBlock x:Name="ErrorText" Foreground="#8A4B00" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,16" BorderBrush="#D8DDE3" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="DataDirectoryText" VerticalAlignment="Center" Foreground="#66707A" TextWrapping="Wrap" />
                <Button Grid.Column="1" Click="CloseButton_OnClick" Content="Chiudi" />
            </Grid>
        </Border>
    </Grid>
</Window>
